TOKEN=
# optional: channel that gets a post for each new stream added with /setlist
ANNOUNCE_CHANNEL_ID=
# YouTube Data API v3 key: /setlist reads a new stream's title and date with it
YOUTUBE_API_KEY=
# the site's admin listener, reachable on the fionastation_default Docker network: /playlist-mod calls it
SITE_ADMIN_URL=http://fionastation-web-1:3001
SITE_ADMIN_SECRET=
# the address fans open, used for the /p/<id> links /playlist posts (default shown)
SITE_PUBLIC_URL=https://fionastation.vercel.app
