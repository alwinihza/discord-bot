TOKEN=
# optional: channel that gets a post for each new stream added with /setlist
ANNOUNCE_CHANNEL_ID=
# YouTube Data API v3 key: /setlist reads a new stream's title and date with it
YOUTUBE_API_KEY=
# the site's admin listener, reachable on the fionastation_default Docker network: /playlist-mod calls it
SITE_ADMIN_URL=http://fionastation-web-1:3001
SITE_ADMIN_SECRET=
# the address fans open, used for the /p/<id> links /playlist posts (default shown)
SITE_PUBLIC_URL=https://fionastation.vercel.app
# optional: channel where commission inquiries from the site are posted; leave empty to turn the feature off
# (needs SITE_ADMIN_URL and SITE_ADMIN_SECRET)
COMMISSIONS_CHANNEL_ID=
# comma-separated Discord user ids allowed to press the commission status buttons
COMMISSION_MANAGER_IDS=
# shared secret the OBS script sends as a Bearer token; generate with `openssl rand -hex 32`; empty turns the go-live webhook off
WEBHOOK_SECRET=
# channel for go-live posts; empty turns the go-live webhook off
LIVE_CHANNEL_ID=
# Fiona's YouTube channel id (UC...), used to find the live stream
YOUTUBE_CHANNEL_ID=
# optional: role to ping when a stream goes live
LIVE_PING_ROLE_ID=
